DATABASE_URL=postgresql+psycopg://weekly:weekly@localhost:5433/weekly_loop
TEST_DATABASE_URL=postgresql+psycopg://weekly:weekly@localhost:5433/weekly_loop_test

# Signs the session cookie. Leave it empty and the API picks a random one at each start.
SESSION_SECRET=generate-a-long-random-string
# Origins allowed to open the WebSocket, comma-separated.
WEB_ORIGIN=http://localhost:3000

# The password every seeded user signs in with. Users an Admin creates get their own.
SEED_PASSWORD=weekly-loop-demo
# Shows a "Use a demo account" button on the sign-in page that signs in as a seeded user.
DEMO_ACCOUNTS=true
# Lets an Admin use Settings to turn on the test forms (add To-Dos and Rocks, tick Milestones)
# and reset all data to the seed. Turn off for a real deployment.
ENABLE_TEST_TOOLS=false

APP_NOW=2026-11-11T15:00:00Z
APP_CLOCK=ticking

# Mounts POST /api/testing/reset so the Playwright suite can restore the seed. Never on in production.
ENABLE_TEST_ROUTES=false
